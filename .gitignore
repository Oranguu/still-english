# The root stores personal material packages. Only reviewed source is public.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/tool/

/tool/*
!/tool/.gitignore
!/tool/README.md
!/tool/ai.py
!/tool/captions.py
!/tool/jobs.py
!/tool/launcher.py
!/tool/packages.py
!/tool/requirements.txt
!/tool/server.py
!/tool/setup.py
!/tool/transcribe.py
!/tool/启动.command
!/tool/安装依赖.command
!/tool/安装语音转写.command
!/tool/static/
!/tool/tests/
!/tool/scripts/
/tool/static/*
!/tool/static/index.html
!/tool/static/app.js
!/tool/static/style.css
!/tool/static/favicon.svg
/tool/tests/*
!/tool/tests/test_core.py
!/tool/tests/test_server.py
!/tool/tests/test_public_files.py
/tool/scripts/*
!/tool/scripts/check_public_files.py

# Defense in depth for private copies accidentally placed in source folders.
**/.state/
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
.DS_Store
._*
.env
.env.*
**/.codex/
**/.ssh/
**/.aws/
**/.npmrc
**/.netrc
**/auth.json
**/credentials.json
**/cookies.txt
**/cookies.json
*.pem
*.key
*.log
*.mp4
*.webm
*.m4v
*.mov
*.mp3
*.wav
*.srt
*.vtt
*.json3
*.info.json
**/manifest.json
*.zip
*.tar
*.gz
